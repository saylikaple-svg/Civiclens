# ==========================================
# ProjectPulse AI Configuration Environment
# Smart India Hackathon 2026 - MoSPI Platform
# ==========================================

# Database Configurations
# SQLite is used by default for zero-setup ease of use.
# For production PostgreSQL, use: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=sqlite:///./projectpulse.db

# Authentication Configurations
# Change the JWT secret in production to a secure, randomly generated string.
JWT_SECRET=sih2026_super_secret_projectpulse_key_jwt_token_12345
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI/ML LLM API Keys (Optional)
# If provided, the platform invokes actual Gemini/OpenAI cloud LLMs for the Document Assistant.
# If omitted, the platform falls back to the built-in local semantic NLP Emulator (works 100% offline).
GEMINI_API_KEY=
OPENAI_API_KEY=

# Local File Storage Outlays
UPLOAD_DIR=uploads

# Firebase Configurations (Optional)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
